{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zjs105910/workbuddy-market/registry/registry-schema.json",
  "title": "WorkBuddy Market 社区注册表 · 收录契约 v2",
  "description": "registry/plugins.json 的内容契约。注意两点：(1) 这里的 version 是**收录契约**的版本，与文件里 runtime 格式字段 schema（当前恒为 1，由 src/workbuddy_market/registry.py 的 REGISTRY_SCHEMA 治理）相互独立——本契约只加严内容规则，不改运行时格式。(2) 运行时解析器（parse_registry）刻意宽松；本契约才是收录/合入门禁：静态字段人工审核后提交，动态字段（stars/pushedAt/latestSha/refreshedAt）由每日 CI 重建，产物与声明字段（packageUrl/packageHash/manifestHash/attestationUrl/platforms/minWorkBuddyVersion/version）由 artifacts.yml 按打包 manifest 回写。强制执行者是 scripts/validate_registry.py（stdlib，无第三方依赖）。",
  "version": 2,

  "type": "object",
  "properties": {
    "schema": { "const": 1 },
    "updatedAt": { "$ref": "#/$defs/date" },
    "_comment": { "type": "string" },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "required": ["schema", "updatedAt", "plugins"],
  "additionalProperties": false,

  "$defs": {
    "date":      { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha1":      { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256":    { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "httpsUrl":  { "type": "string", "pattern": "^https://\\S+$" },
    "repo":      { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },

    "plugin": {
      "type": "object",
      "properties": {
        "repo":                { "$ref": "#/$defs/repo" },
        "displayName":         { "type": "string", "minLength": 1, "maxLength": 80 },
        "displayNameEn":       { "type": "string", "minLength": 1, "maxLength": 120 },
        "category":            { "enum": ["官方", "开发工具", "自动化", "合集", "测试", "设计", "科研", "效率", "商业", "安全", "写作", "未分类"] },
        "description":         { "type": "string", "minLength": 8, "maxLength": 400 },
        "descriptionEn":       { "type": "string", "maxLength": 600 },
        "keywords":            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "maxItems": 12 },
        "homepage":            { "$ref": "#/$defs/httpsUrl" },
        "addedAt":             { "$ref": "#/$defs/date" },
        "license":             { "type": "string", "pattern": "^[A-Za-z0-9.+-]{3,}$" },

        "trust":               { "enum": ["official", "reviewed", "external"] },
        "review":              {
          "type": "object",
          "properties": {
            "status":     { "enum": ["reviewed", "pending", "rejected"] },
            "reviewedAt": { "$ref": "#/$defs/date" },
            "method":     { "type": "string", "minLength": 1 }
          },
          "required": ["status", "reviewedAt", "method"],
          "additionalProperties": false
        },
        "sourceCommit":        { "$ref": "#/$defs/sha1" },

        "permissions":         { "$ref": "#/$defs/permissions" },
        "screenshots":         { "type": "array", "items": { "$ref": "#/$defs/httpsUrl" }, "maxItems": 12 },

        "platforms":           { "type": "array", "items": { "enum": ["windows", "macos", "linux"] }, "uniqueItems": true, "minItems": 1 },
        "minWorkBuddyVersion": { "type": "string", "pattern": "^[><=]*\\s*[0-9]+(\\.[0-9]+){0,2}$" },

        "packageUrl":          { "$ref": "#/$defs/httpsUrl" },
        "packageHash":         { "$ref": "#/$defs/sha256" },
        "manifestHash":        { "$ref": "#/$defs/sha256" },
        "packageSize":         { "type": "integer", "minimum": 0 },
        "version":             { "type": "string", "minLength": 1 },
        "attestationUrl":      { "$ref": "#/$defs/httpsUrl" },

        "stars":               { "type": "integer", "minimum": 0 },
        "pushedAt":            { "$ref": "#/$defs/date" },
        "latestSha":           { "$ref": "#/$defs/sha1" },
        "refreshedAt":         { "$ref": "#/$defs/date" }
      },
      "required": [
        "repo", "displayName", "category", "description", "keywords",
        "addedAt", "trust", "review", "sourceCommit"
      ],
      "additionalProperties": false
    },

    "permissions": {
      "type": "object",
      "properties": {
        "filesystem":  { "$ref": "#/$defs/permValue" },
        "network":     { "$ref": "#/$defs/permValue" },
        "shell":       { "$ref": "#/$defs/permValue" },
        "credentials": { "$ref": "#/$defs/permValue" },
        "subprocess":  { "$ref": "#/$defs/permValue" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "permValue": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      ]
    }
  }
}
